---
layout: base.njk
title: News & Events – The Wheatlands HOA
description: Neighborhood news, Board updates and community events in the Wheatlands HOA.
permalink: /news.html
---
{%- from "macros.njk" import pageHead, docList, updateList, shareRow -%}
{{ pageHead("News & Events", "What the Board is working on and what’s happening around the neighborhood.") }}
<section class="section">
  <div class="container">
    <div class="grid cols-2" style="gap:40px;align-items:start">
      <div>
        <h2>Neighborhood news</h2>
        {%- macro postCard(p) %}
        <article class="card"{% if p.archive_after %} data-archive-after="{{ p.archive_after | isoDate }}"{% endif %}>
          <div class="eyebrow">Posted {{ p.date | isoDate | niceDate }}</div>
          {%- set postUrl = "/news/" + (p | postSlug) + ".html" %}
          <h3><a href="{{ postUrl }}" style="color:inherit;text-decoration:none">{{ p.title }}</a></h3>
          <div class="prose-inline" style="margin-bottom:1em">{{ p.body | md | safe }}</div>
          {% if p.file %}{{ docList([{ file: p.file, title: p.file_label or "Attachment", note: "" }]) }}{% endif %}
          {{ shareRow(siteUrl + postUrl, p.title) }}
        </article>
        {%- endmacro %}
        {#- Posts with an "archive after" date move to Past news once it passes: at build time here, and in the browser (site.js) between builds #}
        {%- set pastCount = 0 %}
        <div class="stack" id="current-news">
        {%- for p in news.posts | byDateDesc %}
          {%- if p.archive_after and (p.archive_after | isoDate) < buildDate %}{% set pastCount = pastCount + 1 %}{% else %}{{ postCard(p) }}{% endif %}
        {%- endfor %}
        </div>
        <details class="legal" id="past-news"{% if not pastCount %} hidden{% endif %}>
          <summary>Past news</summary>
          <div class="stack" style="padding:6px 0 10px">
          {%- for p in news.posts | byDateDesc %}
            {%- if p.archive_after and (p.archive_after | isoDate) < buildDate %}{{ postCard(p) }}{% endif %}
          {%- endfor %}
          </div>
        </details>
        <h2 style="margin-top:48px">Community events</h2>
        <div class="grid" style="gap:14px" id="events">
          {%- for e in news.events | byDateDesc %}{% set d = e.date | isoDate %}
          <div class="card person" data-event-date="{{ d }}"><span class="avatar" style="border-radius:4px">{{ d | monthAbbr }}</span><div><b>{{ e.title }} <span class="tag done" data-past-tag hidden>Past</span></b><small style="display:block">{{ e.details }}</small></div></div>
          {%- endfor %}
        </div>
        <p class="small muted" style="margin-top:12px">Watch this page and our <a href="{{ site.facebook_url }}" target="_blank" rel="noopener">Facebook page</a> for upcoming events.</p>
      </div>
      <div>
        <h2>Board updates</h2>
        {{ updateList(news.updates) }}
      </div>
    </div>
  </div>
</section>
